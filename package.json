{
  "name": "kin",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Self-hosted personal agent driven by claude -p",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "kin": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts start",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/cli.js start",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "build:all": "npm run build && npm run web:build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "hono": "^4.13.12",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
